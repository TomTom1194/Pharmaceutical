@model List<WebApp.Dtos.AdminPositionApplicationItemDto>

@{
    ViewBag.Title = "Applications";
    ViewBag.Subtitle = "Pick a position to see who has applied to it.";

    var positions = ViewBag.Positions as List<WebApp.Dtos.AdminPositionSummaryDto> ?? new();
    int? selectedPositionId = ViewBag.SelectedPositionId;

    string AccountStatusBadgeClass(string? status) => (status ?? "").ToLowerInvariant() switch
    {
        "active" => "bg-success",
        "pending" => "bg-warning",
        "inactive" => "bg-danger",
        _ => "bg-secondary"
    };

    string ApplicationStatusBadgeClass(string status) => (status ?? "").ToLowerInvariant() switch
    {
        "applied" => "bg-secondary",
        "reviewing" or "in review" or "shortlisted" => "bg-warning",
        "sent" or "interview" or "interviewing" or "offered" or "hired" or "accepted" => "bg-success",
        "rejected" or "withdrawn" => "bg-danger",
        _ => "bg-secondary"
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Positions</h5>
        @if (positions.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var p in positions)
                {
                    var isSelected = selectedPositionId == p.PositionId;
                    <a asp-action="Index" asp-route-positionId="@p.PositionId"
                       class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") btn-sm">
                        @p.Title
                        <span class="badge @(isSelected ? "bg-light text-dark" : "bg-secondary") ms-1">@p.ApplicationCount</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No positions found.</p>
        }
    </div>
</div>

@if (!selectedPositionId.HasValue)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            Select a position above to see its applicants.
        </div>
    </div>
}
else
{
    var selectedPosition = positions.FirstOrDefault(p => p.PositionId == selectedPositionId.Value);
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">
                Applicants @(selectedPosition != null ? $"— {selectedPosition.Title}" : "")
            </h5>
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Account Status</th>
                        <th>CV</th>
                        <th>Applied</th>
                        <th>Application Status</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@(a.FullName ?? "(No name)")</td>
                            <td>@a.Email</td>
                            <td>@(a.Phone ?? "-")</td>
                            <td><span class="badge @AccountStatusBadgeClass(a.AccountStatus)">@(a.AccountStatus ?? "-")</span></td>
                            <td>
                                @if (a.HasResume)
                                {
                                    <span class="badge bg-success">Has CV</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No CV</span>
                                }
                            </td>
                            <td>@a.AppliedDate.ToLocalTime().ToString("d")</td>
                            <td><span class="badge @ApplicationStatusBadgeClass(a.ApplicationStatus)">@a.ApplicationStatus</span></td>
                            <td>
                                <a asp-action="CandidateDetail" asp-route-id="@a.CandidateId" asp-route-positionId="@selectedPositionId" class="btn btn-sm btn-primary">View CV</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">No applications for this position yet.</p>
            }
        </div>
    </div>
}
