@model List<WebApp.Dtos.AdminPositionApplicationItemDto>

@{
    ViewBag.Title = "Applications";
    ViewBag.Subtitle = "All candidates who have applied to your open positions.";

    var positions = ViewBag.Positions as List<WebApp.Dtos.AdminPositionSummaryDto> ?? new();
    int? selectedPositionId = ViewBag.SelectedPositionId;
    string? status = ViewBag.Status;
    string? keyword = ViewBag.Keyword;

    string AccountPillClass(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "active" => "admin-pill-yes",
        "pending" => "admin-pill-pending",
        "inactive" => "admin-pill-no",
        _ => "admin-pill-category"
    };

    string ApplicationPillClass(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "applied" or "reviewing" or "in review" or "shortlisted" => "admin-pill-pending",
        "sent" or "interview" or "interviewing" or "offered" or "hired" or "accepted" => "admin-pill-yes",
        "rejected" or "withdrawn" => "admin-pill-no",
        _ => "admin-pill-category"
    };
}

<div class="admin-page-header">
    <div>
        <h1>Applications</h1>
        <p>All candidates who have applied to your open positions</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Positions</h5>
        @if (positions.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" asp-route-status="@status" asp-route-keyword="@keyword"
                   class="btn @(!selectedPositionId.HasValue ? "btn-primary" : "btn-outline-primary") btn-sm">
                    All positions
                </a>
                @foreach (var p in positions)
                {
                    var isSelected = selectedPositionId == p.PositionId;
                    <a asp-action="Index" asp-route-positionId="@p.PositionId" asp-route-status="@status" asp-route-keyword="@keyword"
                       class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") btn-sm">
                        @p.Title
                        <span class="badge @(isSelected ? "bg-light text-dark" : "bg-secondary") ms-1">@p.ApplicationCount</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No positions found.</p>
        }
    </div>
</div>

<form method="get" asp-action="Index" class="admin-filter-bar">
    <input type="hidden" name="positionId" value="@selectedPositionId"/>

    <div class="admin-filter-search">
        <input type="text" name="keyword" placeholder="Search by name/email..." value="@keyword"/>
    </div>

    <select name="status" class="admin-filter-select">
        <option value="">All statuses</option>
        @foreach (var s in new[] { "Applied", "Sent" })
        {
            <option value="@s" selected="@(s == status)">@s</option>
        }
    </select>

    <button type="submit" class="admin-btn-filter">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 5h16l-6 8v6l-4-2v-4z"/></svg>
        Filter
    </button>
    <a asp-action="Index" asp-route-positionId="@selectedPositionId" class="admin-btn-clear">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
        Clear filter
    </a>
</form>

<div class="admin-table-card">
    <table class="admin-table">
        <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Position</th>
            <th>Account Status</th>
            <th>CV</th>
            <th>Applied</th>
            <th>Application Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (Model != null)
        {
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-semibold">@(a.FullName ?? "(No name)")</td>
                    <td>@a.Email</td>
                    <td>@(a.Phone ?? "-")</td>
                    <td>@(a.PositionTitle ?? "-")</td>
                    <td><span class="admin-pill @AccountPillClass(a.AccountStatus)">@(a.AccountStatus ?? "-")</span></td>
                    <td>
                        @if (a.HasResume)
                        {
                            <span class="admin-pill admin-pill-yes">Yes</span>
                        }
                        else
                        {
                            <span class="admin-pill admin-pill-no">No</span>
                        }
                    </td>
                    <td>@a.AppliedDate.ToLocalTime().ToString("d")</td>
                    <td><span class="admin-pill @ApplicationPillClass(a.ApplicationStatus)">@a.ApplicationStatus</span></td>
                    <td>
                        <div class="admin-row-actions">
                            <a class="admin-icon-btn admin-icon-btn-view" asp-action="CandidateDetail" asp-route-id="@a.CandidateId" asp-route-positionId="@a.PositionId" title="View CV">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center text-muted py-4">No matching applications found.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
