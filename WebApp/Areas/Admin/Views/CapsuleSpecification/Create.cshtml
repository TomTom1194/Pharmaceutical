@model CapsuleSpecification
@{
    ViewBag.Title = "Add capsule filling specification";
    var product = (Product)ViewBag.Product;
}

<h2>Add capsule filling specification</h2>

<form asp-action="Create" method="post" style="max-width:500px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId"/>

    <div class="mb-3">
        <label>Product</label>
        <input class="form-control" value="@product.ModelName" disabled/>
    </div>

    <div class="mb-3">
        <label>Output</label>
        <input asp-for="Output" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Capsule size (mm)</label>
        <input asp-for="CapsuleSizeMm" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Machine dimension</label>
        <input asp-for="MachineDimension" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Shipping weight (kg)</label>
        <input asp-for="ShippingWeightKg" class="form-control"/>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="Product" asp-action="Index">Cancel</a>
    </div>
</form>
