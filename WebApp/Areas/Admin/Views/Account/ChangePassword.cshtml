@model WebApp.Dtos.ChangePasswordRequestDto
@{
    ViewBag.Title = "Change Password";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #212529;">Change Password</h3>
            <p class="text-muted mb-0 small">Update the password you use to sign in to the Admin panel</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5" style="max-width:480px;">
            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="All" class="text-danger small"></div>

                <div class="mb-4">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control form-control-lg bg-light" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control form-control-lg bg-light" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg bg-light" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success fw-medium px-4 rounded-pill">Change Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
