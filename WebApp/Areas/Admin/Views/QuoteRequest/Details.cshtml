@using WebApp.Helpers
@model QuoteRequest
@{
    ViewBag.Title = "Quote request detail";
    string PillClass(string? s) => s switch
    {
        "Done" => "admin-pill-yes",
        "Rejected" => "admin-pill-no",
        _ => "admin-pill-pending"
    };
}
<div class="admin-page-header">
    <div>
        <h1>Quote request detail</h1>
        <p>Review the information submitted by the customer</p>
    </div>
    <a asp-action="Index" class="admin-btn-clear">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to list
    </a>
</div>
<div class="admin-detail-card">
    <div class="admin-detail-grid">
        <div class="admin-detail-item">
            <label>Full name</label>
            <div>@Model.FullName</div>
        </div>
        <div class="admin-detail-item">
            <label>Company</label>
            <div>@(Model.CompanyName ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>Email</label>
            <div>@Model.Email</div>
        </div>
        <div class="admin-detail-item">
            <label>Phone</label>
            <div>@(Model.Phone ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>Address</label>
            <div>@(Model.Address ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>City</label>
            <div>@(Model.City ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>State</label>
            <div>@(Model.State ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>Postal code</label>
            <div>@(Model.PostalCode ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>Country</label>
            <div>@(Model.Country ?? "-")</div>
        </div>
        <div class="admin-detail-item">
            <label>Submitted at</label>
            <div>@(Model.SubmittedAt.ToVietnamTime()?.ToString("dd/MM/yyyy HH:mm") ?? "-") (GMT+7)</div>
        </div>
        <div class="admin-detail-item">
            <label>Status</label>
            <div><span class="admin-pill @PillClass(Model.Status)">@Model.Status</span></div>
        </div>
        <div class="admin-detail-item full">
            <label>Comments</label>
            <div>@(Model.Comments ?? "-")</div>
        </div>
    </div>
    @if (Model.Status is "Pending")
    {
        <div class="admin-detail-actions">
            <form asp-action="Confirm" asp-route-id="@Model.QuoteId" method="post">
                <button type="submit" class="admin-btn-primary" onclick="return confirm('Confirm this quote request as Done?');">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    Confirm
                </button>
            </form>
            <form asp-action="Cancel" asp-route-id="@Model.QuoteId" method="post">
                <button type="submit" class="admin-btn-danger" onclick="return confirm('Reject this quote request?');">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    Cancel
                </button>
            </form>
        </div>
    }
</div>
