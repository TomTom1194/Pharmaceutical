@model TabletSpecification
@{
    ViewBag.Title = "Add tablet press specification";
    var product = (Product)ViewBag.Product;
}

<h2>Add tablet press specification</h2>

<form asp-action="Create" method="post" style="max-width:500px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId"/>

    <div class="mb-3">
        <label>Product</label>
        <input class="form-control" value="@product.ModelName" disabled/>
    </div>

    <div class="mb-3">
        <label>Model number</label>
        <input asp-for="ModelNumber" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Number of dies</label>
        <input asp-for="Dies" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Max pressure</label>
        <input asp-for="MaxPressure" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Max diameter (mm)</label>
        <input asp-for="MaxDiameterMm" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Max fill depth (mm)</label>
        <input asp-for="MaxDepthFillMm" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Production capacity</label>
        <input asp-for="ProductionCapacity" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Machine size</label>
        <input asp-for="MachineSize" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Net weight (kg)</label>
        <input asp-for="NetWeightKg" class="form-control"/>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-area="Admin" asp-controller="Product" asp-action="Index">Cancel</a>
    </div>
</form>
