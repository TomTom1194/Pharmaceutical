@{
    var currentController = (string)ViewContext.RouteData.Values["controller"]!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/>
</head>
<body>
<div class="admin-shell">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-area="Admin" asp-controller="Product" asp-action="Index">
            <span style="font-size:16px">XYZ Pharmaceutical Admin</span>
        </a>

        <nav class="admin-nav">
            <a class="admin-nav-item @(currentController == "Product" ? "active" : "")" asp-area="Admin" asp-controller="Product" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"/></svg>
                <span>Products</span>
            </a>
            <a class="admin-nav-item @(currentController == "ProductCategory" ? "active" : "")" asp-area="Admin" asp-controller="ProductCategory" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                <span>Categories</span>
            </a>
            <a class="admin-nav-item @(currentController == "QuoteRequest" ? "active" : "")" asp-area="Admin" asp-controller="QuoteRequest" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6M9 9h1"/></svg>
                <span>Quote Requests</span>
            </a>
        </nav>

        <div class="admin-logout">
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-breadcrumb">
                <div class="admin-breadcrumb-text">
                    <span>Home</span><span>/</span><span class="current">@ViewBag.Title</span>
                </div>
            </div>
            <div class="admin-topbar-right">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
                <div class="admin-avatar">
                    <div class="admin-avatar-circle">AD</div>
                    <div>
                        <div class="admin-avatar-name">Admin</div>
                        <div class="admin-avatar-role">Administrator</div>
                    </div>
                </div>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
