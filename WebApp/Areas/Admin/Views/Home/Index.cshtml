@model WebApp.Dtos.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";

    string DateLabel(DateTime? dt)
    {
        if (dt == null) return "—";
        var d = dt.Value.ToLocalTime();
        if (d.Date == DateTime.Today) return "Today, " + d.ToString("hh:mm tt");
        if (d.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return d.ToString("dd MMM yyyy");
    }

    string StatusBadge(string? status) => status?.ToLower() switch
    {
        "resolved" or "completed" => "bg-success-subtle text-success-emphasis",
        "pending" or null => "bg-warning-subtle text-warning-emphasis",
        "sent" => "bg-info-subtle text-info-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}

<div class="container-fluid py-2">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: #212529;">Dashboard Overview</h3>
        <p class="text-muted mb-0 small">Welcome back to XYZ Pharmaceutical Admin Portal</p>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Could not load dashboard statistics. Please ensure the API is running.
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-file-earmark-ruled fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 small fw-medium text-uppercase">Pending Quotes</p>
                            <h4 class="fw-bold mb-0">@Model.PendingQuotesCount</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 small fw-medium text-uppercase">New Applicants</p>
                            <h4 class="fw-bold mb-0">@Model.NewApplicantsCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-ruled me-2 text-success"></i>Recent Quote Requests</h5>
                    </div>
                    <div class="card-body p-0 mt-3">
                        @if (!Model.RecentQuotes.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                <p class="small">No quote requests yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0" style="border-collapse: collapse;">
                                    <thead>
                                        <tr style="border-bottom: 2px solid #f1f5f9;">
                                            <th class="ps-4 py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Customer</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Company</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Date</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var q in Model.RecentQuotes)
                                        {
                                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                                <td class="ps-4 py-3 fw-medium" style="font-size: 0.9rem;">@q.FullName</td>
                                                <td class="py-3 text-muted" style="font-size: 0.85rem;">@(q.CompanyName ?? "—")</td>
                                                <td class="py-3 text-muted" style="font-size: 0.85rem;">@DateLabel(q.SubmittedAt)</td>
                                                <td class="py-3"><span class="badge @StatusBadge(q.Status) px-2 py-1">@(q.Status ?? "Pending")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top border-light-subtle p-3 text-center">
                        <a asp-area="Admin" asp-controller="QuoteHandle" asp-action="Index" class="btn btn-sm btn-outline-success fw-medium rounded-pill px-4">
                            View all Quote Requests <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Recent Applicants</h5>
                    </div>
                    <div class="card-body p-0 mt-3">
                        @if (!Model.RecentApplicants.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                <p class="small">No interview invitations yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0" style="border-collapse: collapse;">
                                    <thead>
                                        <tr style="border-bottom: 2px solid #f1f5f9;">
                                            <th class="ps-4 py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Candidate</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Email</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Registered</th>
                                            <th class="py-3 text-muted fw-bold border-0" style="font-size: 0.75rem; text-transform: uppercase;">Account Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in Model.RecentApplicants)
                                        {
                                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                                <td class="ps-4 py-3 fw-medium" style="font-size: 0.9rem;">@(a.CandidateName ?? "—")</td>
                                                <td class="py-3 text-muted" style="font-size: 0.85rem;">@(a.Subject ?? "—")</td>
                                                <td class="py-3 text-muted" style="font-size: 0.85rem;">@DateLabel(a.SentAt)</td>
                                                <td class="py-3"><span class="badge @StatusBadge(a.Status) px-2 py-1">@(a.Status ?? "Active")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top border-light-subtle p-3 text-center">
                        <a asp-area="Admin" asp-controller="Invitation" asp-action="Index" class="btn btn-sm btn-outline-primary fw-medium rounded-pill px-4">
                            View all Invitations <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
