@model IEnumerable<Pharmaceutical.Models.Position>

@{
    ViewBag.Title = "Job Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 fw-bold mb-0">Job Management</h2>
    <a asp-action="Create" class="btn btn-primary px-4 rounded-pill fw-medium">
        <i class="bi bi-plus-lg me-1"></i> Add New Job
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Title</th>
                    <th>Department</th>

                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@item.Title</td>
                            <td>@item.Department</td>

                            <td><span class="badge bg-secondary">@item.Type</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.PositionId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.PositionId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this job?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-briefcase fs-1 d-block mb-3 opacity-50"></i>
                            <p class="mb-0">No job openings found. Click 'Add New Job' to create one.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
