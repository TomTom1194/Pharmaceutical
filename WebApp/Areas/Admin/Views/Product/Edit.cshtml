@model Product
@{
    ViewBag.Title = "Edit product";
    var categories = (List<ProductCategory>)ViewBag.Categories;
    var apiBaseUrl = (string)ViewBag.ApiBaseUrl;
}

<h2>Edit product</h2>

<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data" style="max-width:500px;">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId"/>

    <div class="mb-3">
        <label>Product name<span class="required-mark">*</span></label>
        <input asp-for="ModelName" class="form-control"/>
        <span asp-validation-for="ModelName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Category<span class="required-mark">*</span></label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">-- Select category --</option>
            @foreach (var category in categories)
            {
                <option value="@category.CategoryId">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Output label</label>
        <input asp-for="OutputLabel" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Summary</label>
        <input asp-for="Summary" class="form-control"/>
    </div>

    <div class="mb-3">
        <div class="border rounded p-2">
            <label class="fw-bold">Main image<span class="required-mark">*</span></label>
            @{
                var mainImage = Model.Images.FirstOrDefault(i => i.IsThumbnail == true);
            }
            @if (mainImage != null)
            {
                <img src="@(apiBaseUrl.TrimEnd('/') + mainImage.Url)" style="height:60px;" class="d-block mb-2"/>
            }
            <input class="form-control" type="file" name="mainImage" accept="image/*"/>
        </div>
    </div>

    <div class="mb-3">
        <div class="border rounded p-2">
            <label class="fw-bold">Secondary images (up to 2)</label>
            @{
                var subImages = Model.Images.Where(i => i.IsThumbnail != true).ToList();
            }
            @if (subImages.Any())
            {
                <div class="d-flex gap-2 mb-2">
                    @foreach (var image in subImages)
                    {
                        <img src="@(apiBaseUrl.TrimEnd('/') + image.Url)" style="height:60px;"/>
                    }
                </div>
            }
            <input class="form-control mb-2" type="file" name="subImage1" accept="image/*"/>
            <input class="form-control" type="file" name="subImage2" accept="image/*"/>
        </div>
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="IsPublished" name="IsPublished" value="true" checked="@(Model.IsPublished == true)"/>
            <input type="hidden" name="IsPublished" value="false"/>
            <label class="form-check-label" for="IsPublished">Published</label>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
