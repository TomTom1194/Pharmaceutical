@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
}
@model WebApp.Models.SaveArticleViewModel
@{
    ViewData["Title"] = "New Article";
}
<div class="container-fluid py-2">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <h4 class="fw-bold mb-0">New Article</h4>
    </div>
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-medium">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Article title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Slug <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text text-muted">/news/</span>
                                <input asp-for="Slug" class="form-control font-monospace" placeholder="my-article-slug" />
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Summary</label>
                            <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Short description shown in listing..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Content <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="12" placeholder="Full article content (HTML supported)..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-medium">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">Draft</option>
                                <option value="Published">Published</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Published At</label>
                            <input asp-for="PublishedAt" type="datetime-local" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Author Name</label>
                            <input asp-for="AuthorName" class="form-control" />
                        </div>
                                                                        <div class="mb-3">
                            <label class="form-label fw-medium">Thumbnail Image (1 File Only)</label>
                            <div class="mb-2">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="ThumbOption" id="optUpload" value="upload" checked>
                                    <label class="form-check-label" for="optUpload">Upload Local File</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="ThumbOption" id="optUrl" value="url">
                                    <label class="form-check-label" for="optUrl">Paste External URL</label>
                                </div>
                            </div>
                            <div class="input-group mb-2" id="divUpload">
                                <span class="input-group-text"><i class="bi bi-upload"></i></span>
                                <input type="file" name="ThumbnailFile" id="ThumbnailFile" class="form-control" accept="image/*" />
                            </div>
                            <div class="input-group" id="divUrl" style="display:none;">
                                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="Thumbnail" id="ThumbnailUrl" class="form-control" placeholder="https://..." />
                            </div>
                        </div>
                      </div>
                  </div>
                  <div class="border-top pt-3 text-end">
                      <a asp-action="Index" class="btn btn-outline-secondary me-2 rounded-pill px-4">Cancel</a>
                      <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold">Create Article</button>
                  </div>
              </form>
          </div>
      </div>
  </div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#Content').summernote({
                height: 400,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });
        });
    </script>
    <script>
        const optUpload = document.getElementById('optUpload');
        const optUrl = document.getElementById('optUrl');
        const divUpload = document.getElementById('divUpload');
        const divUrl = document.getElementById('divUrl');
        const fileInput = document.getElementById('ThumbnailFile');
        const urlInput = document.getElementById('ThumbnailUrl');
        function toggleThumbMode() {
            if (optUpload.checked) {
                divUpload.style.display = 'flex';
                divUrl.style.display = 'none';
                urlInput.value = '';
            } else {
                divUpload.style.display = 'none';
                divUrl.style.display = 'flex';
                fileInput.value = '';
            }
        }
        optUpload.addEventListener('change', toggleThumbMode);
        optUrl.addEventListener('change', toggleThumbMode);
    </script>
}
