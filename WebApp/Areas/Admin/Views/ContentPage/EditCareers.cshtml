@model WebApp.Models.ContentPageFormModel
@{
    ViewData["Title"] = "Edit Careers Page";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Edit Careers Page</h2>
            <p class="text-muted mb-0">Update structured content for the Careers page</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="PageId" />
                        <input type="hidden" asp-for="Slug" />
                        <input type="hidden" asp-for="Title" />

                        <h4 class="mb-3 text-primary">Main Banner</h4>

                        <div class="mb-4">
                            <label asp-for="BannerImageUpload" class="form-label fw-medium">Banner Background Image</label>
                            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.BannerImageUrl" alt="Current Banner" class="img-thumbnail" style="max-height: 150px;" />
                                </div>
                            }
                            <input asp-for="BannerImageUpload" type="file" class="form-control" accept="image/*" />
                            <div class="form-text">Upload a background image for the careers hero section.</div>
                            <input type="hidden" asp-for="BannerImageUrl" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="HeroTitle" class="form-label fw-medium">Main Title</label>
                            <input asp-for="HeroTitle" class="form-control" placeholder="e.g. Join Our Team" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="HeroSubtitle" class="form-label fw-medium">Short Description</label>
                            <textarea asp-for="HeroSubtitle" class="form-control" rows="3" placeholder="e.g. Build the future of pharmaceutical manufacturing with us."></textarea>
                        </div>

                        <hr class="my-4" />
                        <h4 class="mb-3 text-primary">About / Why Join Us</h4>

                        <div class="mb-3">
                            <label asp-for="AboutTitle" class="form-label fw-medium">Section Title</label>
                            <input asp-for="AboutTitle" class="form-control" placeholder="e.g. Why Join Us?" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="AboutDescription" class="form-label fw-medium">Description</label>
                            <textarea asp-for="AboutDescription" class="form-control" rows="4"></textarea>
                        </div>



                        <hr class="my-4" />
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-medium">Page Status</label>
                            <select asp-for="Status" class="form-select w-auto">
                                <option value="Published">Published</option>
                                <option value="Draft">Draft</option>
                            </select>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light px-4 me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-medium">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


