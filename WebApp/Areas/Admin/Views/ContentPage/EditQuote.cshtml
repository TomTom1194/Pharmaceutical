@model WebApp.Models.ContentPageFormModel
@{
    ViewData["Title"] = "Edit Quote Page";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #212529;">Edit Quote Request Page</h3>
            <p class="text-muted mb-0 small">Customize the text and contact info displayed on the Quote Request page</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary fw-medium px-4 rounded-pill">
            <i class="bi bi-arrow-left me-2"></i>Back to Pages
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Save" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="PageId" />
                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="Title" />

                <div class="row g-5">
                    <div class="col-lg-8">
                        <h5 class="fw-bold text-success mb-4 border-bottom pb-2">Main Content</h5>

                        <div class="mb-4">
                            <label asp-for="HeroTitle" class="form-label fw-semibold">Heading Title</label>
                            <input asp-for="HeroTitle" class="form-control form-control-lg bg-light" placeholder="e.g. Request a Quote" />
                            <span asp-validation-for="HeroTitle" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="HeroSubtitle" class="form-label fw-semibold">Description / Promise</label>
                            <textarea asp-for="HeroSubtitle" class="form-control bg-light" rows="3" placeholder="e.g. Fill in the form below and our team will get back to you within 1-2 business days."></textarea>
                            <span asp-validation-for="HeroSubtitle" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold text-success mt-5 mb-4 border-bottom pb-2">Contact Information</h5>

                        <div class="mb-4">
                            <label asp-for="QuoteEmail" class="form-label fw-semibold">Contact Email</label>
                            <input asp-for="QuoteEmail" class="form-control bg-light" placeholder="e.g. sales@xyzpharma.com" />
                            <span asp-validation-for="QuoteEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="QuotePhone" class="form-label fw-semibold">Contact Phone</label>
                            <input asp-for="QuotePhone" class="form-control bg-light" placeholder="e.g. +1 (800) 123-4567" />
                            <span asp-validation-for="QuotePhone" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <div class="col-lg-4 border-start">
                        <h5 class="fw-bold text-dark mb-4">Publishing</h5>
                        
                        <div class="mb-4 p-3 bg-light rounded-3">
                            <label asp-for="Status" class="form-label fw-semibold">Page Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Published">Published</option>
                                <option value="Draft">Draft</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Draft pages are not visible to clients.</div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
