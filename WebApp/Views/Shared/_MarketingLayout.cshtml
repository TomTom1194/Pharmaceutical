<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmEquip Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" /> *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    @{
        var isPreview = Context.Request.Query["preview"] == "true";
        // Set by _CandidateLayout when it's rendering the authenticated sidebar
        // shell, so the marketing navbar/footer don't double up with it.
        var hideMarketingChrome = ViewData["HideMarketingChrome"] as bool? ?? false;
        var showChrome = !isPreview && !hideMarketingChrome;
    }

    @if (showChrome)
    {
    <header class="sticky-top shadow">
        <nav class="navbar navbar-expand-lg navbar-light navbar-main">
            <div class="container">
                <a class="navbar-brand me-4" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="PharmEquip" class="navbar-logo" />
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Product" asp-action="Favorites">
                                Favorites <span id="navFavCount" class="badge rounded-pill bg-success" style="display:none;"></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" href="/careers">Careers</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center" style="gap: 15px;">
                        <a asp-controller="QuoteRequest" asp-action="Create" class="btn btn-primary px-4 rounded-pill shadow-sm fw-bold d-none d-md-block">
                            Get a Quote
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @(string.IsNullOrEmpty(User.Identity.Name) ? "My Account" : User.Identity.Name)
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2">
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Candidate" asp-action="Profile">Candidate Portal</a></li>
                                        
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Portal</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-success px-4 rounded-pill shadow-sm fw-medium" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    }

    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    @if (!isPreview)
    {
    <footer class="pt-5 pb-3 mt-auto" style="background-color: #0f172a; color: #94a3b8;">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom" style="border-color: #1e293b !important;">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white mb-3 fw-bold">XYZ Pharmaceutical</h5>
                    <p class="small mb-4" style="line-height: 1.8;">
                        We supply pharmaceutical manufacturing equipment meeting GMP/FDA standards. Serving domestic and international drug manufacturers since 2005.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white opacity-75 hover-opacity-100"><i class="bi bi-linkedin fs-5"></i></a>
                        <a href="#" class="text-white opacity-75 hover-opacity-100"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-white opacity-75 hover-opacity-100"><i class="bi bi-youtube fs-5"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-white fw-semibold mb-4 text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-3">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none footer-link">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-decoration-none footer-link">About Us</a></li>
                        <li><a asp-controller="Product" asp-action="Index" class="text-decoration-none footer-link">Products</a></li>
                        <li><a href="/careers" class="text-decoration-none footer-link">Careers</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-semibold mb-4 text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Contact Us</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-3">
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-envelope text-success"></i> info@xyzpharma.com</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-telephone text-success"></i> +1 (800) 123-4567</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-geo-alt text-success"></i> 21 Bis Hậu Giang, Phường Tân Sơn Nhất, TP HCM</li>
                    </ul>
                </div>
            </div>

            <div class="pt-4 small opacity-75 text-center">
                <p class="mb-0">&copy; @DateTime.Now.Year PharmEquip Portal. All rights reserved.</p>
            </div>
        </div>
    </footer>
    }

    @if (!isPreview)
    {
        <!-- Floating Action Button (FAB) -->
        <a asp-controller="QuoteRequest" asp-action="Create" class="quote-fab shadow-lg pulse-animation" title="Request a Quote">
            <i class="bi bi-chat-quote-fill fs-5 me-2"></i>
            <span class="fw-bold fs-6">Get a Quote</span>
        </a>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            window.updateFavCountBadge = function () {
                var badge = document.getElementById('navFavCount');
                if (!badge) return;
                var count = 0;
                try {
                    count = (JSON.parse(localStorage.getItem('pharma_favorites')) || []).length;
                } catch (e) {
                    count = 0;
                }
                badge.textContent = count;
                badge.style.display = count > 0 ? 'inline-block' : 'none';
            };
            window.updateFavCountBadge();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
