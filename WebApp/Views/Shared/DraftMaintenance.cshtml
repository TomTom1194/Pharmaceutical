@{
    ViewData["Title"] = "Page Under Maintenance";
}

<div class="container py-5 my-5 text-center" style="min-height: 50vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <div class="mb-4">
        <i class="bi bi-tools text-secondary" style="font-size: 4rem; opacity: 0.5;"></i>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-3">Under Maintenance</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
        This page is currently being updated to bring you the most accurate and up-to-date information. Please check back later.
    </p>
    <div class="mt-4">
        <a href="/" class="btn btn-outline-success px-4 rounded-pill fw-medium">Return to Homepage</a>
    </div>
</div>
