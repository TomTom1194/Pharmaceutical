@model WebApp.Dtos.QuoteRequestDto
@{
    ViewData["Title"] = "Quote Request #" + Model.QuoteId;
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-muted text-decoration-none small">&larr; Back to list</a>
            <h2 class="fw-bold mb-0 mt-1">Quote Request #@Model.QuoteId</h2>
        </div>
        @{
            var badge = Model.Status switch
            {
                "Pending" => "warning",
                "Reviewed" => "info",
                "Closed" => "secondary",
                _ => "light"
            };
        }
        <span class="badge bg-@badge text-dark fs-6 px-3 py-2">@Model.Status</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-3" style="font-size:0.75rem; letter-spacing:0.05em">Contact</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted">Full Name</div>
                            <div class="fw-medium">@Model.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Company</div>
                            <div class="fw-medium">@(Model.CompanyName ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Email</div>
                            <div class="fw-medium">@Model.Email</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Phone</div>
                            <div class="fw-medium">@(Model.Phone ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-3" style="font-size:0.75rem; letter-spacing:0.05em">Address</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="small text-muted">Street</div>
                            <div class="fw-medium">@(Model.Address ?? "—")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">City</div>
                            <div class="fw-medium">@(Model.City ?? "—")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted">State</div>
                            <div class="fw-medium">@(Model.State ?? "—")</div>
                        </div>
                        <div class="col-md-2">
                            <div class="small text-muted">Postal</div>
                            <div class="fw-medium">@(Model.PostalCode ?? "—")</div>
                        </div>
                        <div class="col-md-2">
                            <div class="small text-muted">Country</div>
                            <div class="fw-medium">@(Model.Country ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-3" style="font-size:0.75rem; letter-spacing:0.05em">Requirements</h6>
                    <p class="mb-0" style="white-space: pre-wrap;">@(Model.Comments ?? "No details provided.")</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-3" style="font-size:0.75rem; letter-spacing:0.05em">Update Status</h6>
                    <form asp-action="UpdateStatus" asp-route-id="@Model.QuoteId" method="post">
                        @Html.AntiForgeryToken()
                        <select name="status" class="form-select mb-3">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="Reviewed" selected="@(Model.Status == "Reviewed")">Reviewed</option>
                            <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                        </select>
                        <button type="submit" class="btn btn-primary w-100">Save Status</button>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm border-danger">
                <div class="card-body p-4">
                    <h6 class="text-danger text-uppercase mb-2" style="font-size:0.75rem; letter-spacing:0.05em">Danger Zone</h6>
                    <p class="small text-muted mb-3">This action cannot be undone.</p>
                    <form asp-action="Delete" asp-route-id="@Model.QuoteId" method="post"
                          onsubmit="return confirm('Delete this quote request?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100">Delete Request</button>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body p-4">
                    <h6 class="text-muted text-uppercase mb-2" style="font-size:0.75rem; letter-spacing:0.05em">Submitted</h6>
                    <p class="mb-0 fw-medium">@(Model.SubmittedAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")</p>
                </div>
            </div>
        </div>
    </div>
</div>
