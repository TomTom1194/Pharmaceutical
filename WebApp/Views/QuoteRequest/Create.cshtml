@model WebApp.Models.QuoteFormModel
@{
    var content = ViewBag.ContentModel as WebApp.Models.HomePageContentModel;
    var heroTitle = !string.IsNullOrEmpty(content?.HeroTitle) ? content.HeroTitle : "Request a Quote";
    var heroSubtitle = !string.IsNullOrEmpty(content?.HeroSubtitle) ? content.HeroSubtitle : "Fill in the form below and our team will get back to you within 1–2 business days.";
    var email = !string.IsNullOrEmpty(content?.QuoteEmail) ? content.QuoteEmail : "sales@xyzpharma.com";
    var phone = !string.IsNullOrEmpty(content?.QuotePhone) ? content.QuotePhone : "+1 (800) 123-4567";

    ViewData["Title"] = heroTitle;
}

<div class="py-5" style="background-color: #f8fafc; min-height: calc(100vh - 65px);">
    <div class="container py-lg-4">
        
        <div class="row g-5">
            <!-- Left Column: Info & Trust -->
            <div class="col-lg-4">
                <div class="pe-lg-4 sticky-top" style="top: 80px; z-index: 1;">
                    <span class="text-success fw-bold text-uppercase letter-spacing-1 small d-block mb-2">Get in Touch</span>
                    <h1 class="display-5 fw-bold text-dark mb-4">@heroTitle</h1>
                    <p class="fs-5 text-secondary mb-5" style="font-weight: 300;">@heroSubtitle</p>

                    <div class="mb-5">
                        <h5 class="fw-bold text-dark mb-3">Direct Contact</h5>
                        <ul class="list-unstyled d-flex flex-column gap-3 text-secondary">
                            <li class="d-flex align-items-center gap-3">
                                <div class="bg-white text-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                                    <i class="bi bi-envelope"></i>
                                </div>
                                <span>@email</span>
                            </li>
                            <li class="d-flex align-items-center gap-3">
                                <div class="bg-white text-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <span>@phone</span>
                            </li>
                        </ul>
                    </div>

                    <div class="p-4 bg-white rounded-4 shadow-sm border" style="border-color: #e2e8f0 !important;">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-check text-success me-2"></i>Secure & Confidential</h6>
                        <p class="small text-muted mb-0">Your project details are kept strictly confidential. We only use this information to provide an accurate estimate.</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Form -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
                    <div class="card-body p-4 p-md-5 bg-white">
                        <form asp-action="Create" method="post">
                            @Html.AntiForgeryToken()

                            <h4 class="fw-bold mb-4 text-dark border-bottom pb-3">Contact Information</h4>

                            <div class="row g-4 mb-5">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-medium text-secondary">Full Name <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control form-control-lg bg-light border-0" placeholder="John Smith" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CompanyName" class="form-label fw-medium text-secondary">Company Name</label>
                                    <input asp-for="CompanyName" class="form-control form-control-lg bg-light border-0" placeholder="Your company (optional)" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-medium text-secondary">Email <span class="text-danger">*</span></label>
                                    <input asp-for="Email" class="form-control form-control-lg bg-light border-0" type="email" placeholder="john@company.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-medium text-secondary">Phone</label>
                                    <input asp-for="Phone" class="form-control form-control-lg bg-light border-0" placeholder="+84 ..." />
                                </div>
                            </div>

                            <h4 class="fw-bold mb-4 text-dark border-bottom pb-3">Location & Delivery</h4>

                            <div class="row g-4 mb-5">
                                <div class="col-12">
                                    <label asp-for="Address" class="form-label fw-medium text-secondary">Street Address</label>
                                    <input asp-for="Address" class="form-control form-control-lg bg-light border-0" placeholder="123 Industrial Zone..." />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="City" class="form-label fw-medium text-secondary">City</label>
                                    <input asp-for="City" class="form-control form-control-lg bg-light border-0" placeholder="Ho Chi Minh City" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="State" class="form-label fw-medium text-secondary">State / Province</label>
                                    <input asp-for="State" class="form-control form-control-lg bg-light border-0" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PostalCode" class="form-label fw-medium text-secondary">Postal Code</label>
                                    <input asp-for="PostalCode" class="form-control form-control-lg bg-light border-0" placeholder="70000" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Country" class="form-label fw-medium text-secondary">Country</label>
                                    <input asp-for="Country" class="form-control form-control-lg bg-light border-0" placeholder="Vietnam" />
                                </div>
                            </div>

                            <h4 class="fw-bold mb-4 text-dark border-bottom pb-3">Project Requirements</h4>

                            <div class="mb-5">
                                <label asp-for="Comments" class="form-label fw-medium text-secondary">Description & Requirements <span class="text-danger">*</span></label>
                                <textarea asp-for="Comments" class="form-control bg-light border-0" rows="5" placeholder="Please describe the equipment you need, production capacity, GMP requirements, etc."></textarea>
                                <span asp-validation-for="Comments" class="text-danger small"></span>
                            </div>

                            <div class="text-end mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill fw-bold shadow-sm hover-lift">Submit Request <i class="bi bi-send ms-2"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
