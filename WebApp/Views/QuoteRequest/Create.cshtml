@model WebApp.Models.QuoteFormModel
@{
    ViewData["Title"] = "Get a Quote";
}

<div class="bg-light py-5 mb-4 border-bottom">
    <div class="container">
        <h1 class="fw-bold mb-1">Request a Quote</h1>
        <p class="text-muted mb-0">Fill in the form below and our team will get back to you within 1–2 business days.</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <h5 class="fw-semibold mb-4 text-primary border-bottom pb-2">Contact Information</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" placeholder="John Smith" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-medium">Company Name</label>
                                <input asp-for="CompanyName" class="form-control" placeholder="Your company (optional)" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="john@company.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-medium">Phone</label>
                                <input asp-for="Phone" class="form-control" placeholder="+84 ..." />
                            </div>
                        </div>

                        <h5 class="fw-semibold mb-4 text-primary border-bottom pb-2">Address</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-medium">Street Address</label>
                                <input asp-for="Address" class="form-control" placeholder="123 Industrial Zone..." />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-medium">City</label>
                                <input asp-for="City" class="form-control" placeholder="Ho Chi Minh City" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="State" class="form-label fw-medium">State / Province</label>
                                <input asp-for="State" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="PostalCode" class="form-label fw-medium">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control" placeholder="70000" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Country" class="form-label fw-medium">Country</label>
                                <input asp-for="Country" class="form-control" placeholder="Vietnam" />
                            </div>
                        </div>

                        <h5 class="fw-semibold mb-4 text-primary border-bottom pb-2">Equipment Requirements</h5>

                        <div class="mb-4">
                            <label asp-for="Comments" class="form-label fw-medium">Description & Requirements</label>
                            <textarea asp-for="Comments" class="form-control" rows="5"
                                      placeholder="Please describe the equipment you need, production capacity, GMP standards required, etc."></textarea>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary px-5">Submit Request</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
