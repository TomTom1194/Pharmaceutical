@model List<WebApp.Dtos.QuoteRequestDto>
@{
    ViewData["Title"] = "Manage Quote Requests";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Quote Requests</h2>
            <p class="text-muted mb-0">@Model.Count total requests</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Full Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@item.QuoteId</td>
                                <td class="fw-medium">@item.FullName</td>
                                <td class="text-muted">@(item.CompanyName ?? "—")</td>
                                <td>@item.Email</td>
                                <td class="text-muted small">@(item.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>
                                    @{
                                        var badge = item.Status switch
                                        {
                                            "Pending" => "warning",
                                            "Reviewed" => "info",
                                            "Closed" => "secondary",
                                            _ => "light"
                                        };
                                    }
                                    <span class="badge bg-@badge text-dark">@item.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.QuoteId"
                                       class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">No quote requests found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
