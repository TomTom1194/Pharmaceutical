@model List<WebApp.Models.ArticleAdminDto>
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "News & Updates";
    var top3 = ViewBag.Top3 as List<WebApp.Models.ArticleAdminDto> ?? new List<WebApp.Models.ArticleAdminDto>();
    var editorsPicks = ViewBag.EditorsPicks as List<WebApp.Models.ArticleAdminDto> ?? new List<WebApp.Models.ArticleAdminDto>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
        .hero-carousel .carousel-item { height: 450px; border-radius: 1rem; overflow: hidden; }
        .hero-carousel .carousel-item img { height: 100%; width: 100%; object-fit: cover; }
        .hero-overlay { background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 100%); position: absolute; inset: 0; }
        .horizontal-card img { width: 220px; height: 100%; object-fit: cover; }
        @@media (max-width: 768px) { .horizontal-card img { width: 100%; height: 200px; } }
    </style>
}

<section class="py-5 min-vh-100" style="background-color: #f0fdf4;">
    <div class="container py-3">
        <div class="row g-5">
            <!-- Main Content Area (8 Cols) -->
            <div class="col-lg-8">
                
                @if (top3 != null && top3.Count > 0)
                {
                    <!-- Hero Carousel -->
                    <div id="newsCarousel" class="carousel slide hero-carousel mb-5 shadow-lg" data-bs-ride="carousel" data-aos="fade-up">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < top3.Count; i++)
                            {
                                <button type="button" data-bs-target="#newsCarousel" data-bs-slide-to="@i" class="@(i==0?"active":"")"></button>
                            }
                        </div>
                        <div class="carousel-inner h-100">
                            @for (int i = 0; i < top3.Count; i++)
                            {
                                var a = top3[i];
                                <div class="carousel-item h-100 @(i==0?"active":"")">
                                    <img src="@a.Thumbnail" alt="@a.Title">
                                    <div class="hero-overlay d-flex flex-column justify-content-end p-4 p-md-5">
                                        <span class="badge bg-danger mb-3 align-self-start py-2 px-3 fs-6 rounded-pill">BREAKING NEWS</span>
                                        <h2 class="text-white fw-bold mb-3 display-6" style="line-height: 1.2;">@a.Title</h2>
                                        <div class="d-flex align-items-center text-light small gap-3 mt-3">
                                            <span><i class="bi bi-clock me-1"></i> @(a.PublishedAt?.ToString("dd MMM yyyy"))</span>
                                            <a asp-controller="News" asp-action="Detail" asp-route-slug="@a.Slug" 
                                               class="btn btn-outline-light rounded-pill ms-auto px-4">Read Full Story</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#newsCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#newsCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                }

                <!-- Latest Updates (Single Column Horizontal Cards) -->
                <div class="d-flex align-items-center mb-4" data-aos="fade-up">
                    <h3 class="fw-bold m-0 text-success"><i class="bi bi-newspaper me-2"></i>Latest Updates</h3>
                    <div class="flex-grow-1 border-bottom ms-3 border-2 border-success opacity-25"></div>
                </div>

                <div class="d-flex flex-column gap-4 mb-5">
                    @foreach (var a in Model)
                    {
                        <div class="card border-0 shadow-sm rounded-4 hover-lift overflow-hidden bg-white horizontal-card" data-aos="fade-up">
                            <a asp-controller="News" asp-action="Detail" asp-route-slug="@a.Slug" class="text-decoration-none text-dark d-flex flex-column flex-md-row">
                                @if (!string.IsNullOrEmpty(a.Thumbnail))
                                {
                                    <img src="@a.Thumbnail" alt="@a.Title" />
                                }
                                <div class="card-body p-4 d-flex flex-column justify-content-center">
                                    <span class="badge bg-success bg-opacity-10 text-success mb-2 align-self-start px-2 py-1">Industry</span>
                                    <h5 class="fw-bold mb-3 lh-base">@a.Title</h5>
                                    <p class="text-secondary small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@a.Summary</p>
                                    <div class="d-flex align-items-center text-muted small mt-auto">
                                        <i class="bi bi-clock me-2 text-success"></i> @(a.PublishedAt?.ToString("MMM dd, yyyy"))
                                        <span class="ms-auto fw-bold text-success">Read more <i class="bi bi-arrow-right small"></i></span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5 mb-5" data-aos="fade-up">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-start-pill px-4" href="?search=@ViewBag.Search&page=@(currentPage - 1)">Previous</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="?search=@ViewBag.Search&page=@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link rounded-end-pill px-4" href="?search=@ViewBag.Search&page=@(currentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <!-- Sidebar (4 Cols) -->
            <div class="col-lg-4" data-aos="fade-left">
                <!-- Search Bar -->
                <div class="card border-0 shadow-sm rounded-4 mb-5 p-4 bg-white">
                    <h5 class="fw-bold mb-3">Search</h5>
                    <form method="get" class="d-flex">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control rounded-start-pill border-end-0 bg-light px-4" placeholder="Search news..." />
                        <button type="submit" class="btn btn-light border border-start-0 rounded-end-pill px-3 bg-light">
                            <i class="bi bi-search text-muted"></i>
                        </button>
                    </form>
                </div>

                <!-- Editors' Picks -->
                <div class="card border-0 shadow-sm rounded-4 mb-5 p-4 bg-white">
                    <h5 class="fw-bold mb-4 pb-2 border-bottom border-2 border-success d-inline-block">Editors' Picks</h5>
                    
                    @if (editorsPicks.Any())
                    {
                        <div class="d-flex flex-column gap-4">
                            @foreach (var pick in editorsPicks)
                            {
                                <a asp-controller="News" asp-action="Detail" asp-route-slug="@pick.Slug" class="text-decoration-none text-dark hover-lift">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-4">
                                            <img src="@pick.Thumbnail" class="img-fluid rounded-3" style="height: 80px; object-fit: cover;" alt="@pick.Title">
                                        </div>
                                        <div class="col-8">
                                            <h6 class="fw-bold mb-1 lh-sm" style="font-size:0.95rem;">@pick.Title</h6>
                                            <small class="text-muted"><i class="bi bi-clock me-1"></i> @(pick.PublishedAt?.ToString("dd MMM"))</small>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">No editor picks currently available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });
    </script>
}
