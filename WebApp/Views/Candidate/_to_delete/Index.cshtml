@{
    ViewBag.Title = "Candidate Portal";
    ViewBag.Subtitle = "Welcome back! Manage your profile and resume from here.";
    Layout = "_Layout";
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="icon-btn mb-3" style="border:none;background:var(--green-100);color:var(--green-700);">
                    <i class="bi bi-person-vcard"></i>
                </div>
                <h5 class="card-title">My CV</h5>
                <p class="card-text">View your personal information, education and work experience.</p>
                <a asp-action="Profile" asp-controller="Candidate" class="btn btn-primary">Go to My CV</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="icon-btn mb-3" style="border:none;background:var(--green-100);color:var(--green-700);">
                    <i class="bi bi-briefcase"></i>
                </div>
                <h5 class="card-title">My Applications</h5>
                <p class="card-text">See the positions you have applied to and their status.</p>
                <a asp-action="MyApplications" asp-controller="Candidate" class="btn btn-primary">Go to My Applications</a>
            </div>
        </div>
    </div>
</div>
