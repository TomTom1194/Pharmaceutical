@model List<WebApp.Dtos.ApplicationDto>

@{
    ViewBag.Title = "My Applications";
    ViewBag.Subtitle = "Positions you have applied to.";
    Layout = "_CandidateLayout";

    string StatusBadgeClass(string status) => (status ?? "").ToLowerInvariant() switch
    {
        "applied" => "bg-secondary",
        "reviewing" or "in review" or "shortlisted" => "bg-warning",
        "sent" or "interview" or "interviewing" or "offer" or "offered" or "hired" or "accepted" => "bg-success",
        "decline" or "declined" or "rejected" or "withdrawn" => "bg-danger",
        _ => "bg-secondary"
    };
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>Position</th>
                    <th>Department</th>
                    <th>Applied Date</th>
                    <th>Status</th>
                    <th>Detail</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td class="fw-semibold">@app.PositionTitle</td>
                        <td>@app.Department</td>
                        <td>@app.AppliedDate.ToLocalTime().ToString("g")</td>
                        <td><span class="badge @StatusBadgeClass(app.Status)">@app.Status</span></td>
                        <td>
                            <a asp-action="ApplicationDetail" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No positions applied yet</p>
        }
    </div>
</div>
