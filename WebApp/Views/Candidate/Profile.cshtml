@model WebApp.Dtos.CandidateProfileDto

@{
    ViewBag.Title = "My CV";
    ViewBag.Subtitle = "Your personal information, education and work experience.";
    Layout = "_CandidateLayout";
}

@if (Model != null)
{
    <div class="d-flex justify-content-end gap-2 mb-3">
        <a asp-action="UpdateResume" asp-controller="Candidate" class="btn btn-primary">Update</a>
        <a asp-action="ExportCv" asp-controller="Candidate" class="btn btn-outline-secondary" target="_blank">Export</a>
    </div>
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body d-flex gap-3 align-items-start">
            @if (Model.HasProfileImage)
            {
                <img src="@Url.Action("ProfileImage", "Candidate")" alt="Profile photo"
                     class="rounded-circle flex-shrink-0" style="width:100px;height:100px;object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center flex-shrink-0 text-muted"
                     style="width:100px;height:100px;">No photo</div>
            }
            <div>
                <h5 class="card-title">@Model.FullName</h5>
                <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                <p class="mb-1"><strong>Address:</strong> @Model.Address</p>
                <p class="mb-0"><strong>Summary:</strong> @Model.Summary</p>
            </div>
        </div>
    </div>

    <h5>Education</h5>
    @if (Model.Educations.Any())
    {
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Institution</th>
                <th>Qualification</th>
                <th>Field</th>
                <th>Start</th>
                <th>End</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Educations)
            {
                <tr>
                    <td>@e.Institution</td>
                    <td>@e.Qualification</td>
                    <td>@e.Field</td>
                    <td>@(e.StartDate?.ToString("MM/yyyy"))</td>
                    <td>@(e.EndDate?.ToString("MM/yyyy"))</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No education records yet.</p>
    }

    <h5>Work Experience</h5>
    @if (Model.WorkExperiences.Any())
    {
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Employer</th>
                <th>Title</th>
                <th>Start</th>
                <th>End</th>
                <th>Description</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var w in Model.WorkExperiences)
            {
                <tr>
                    <td>@w.Employer</td>
                    <td>@w.Title</td>
                    <td>@(w.StartDate?.ToString("MM/yyyy"))</td>
                    <td>@(w.EndDate?.ToString("MM/yyyy"))</td>
                    <td>@w.Description</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No work experience records yet.</p>
    }
}
else
{
    <p>CV information is not available.</p>
}
