@{
    ViewBag.Title = "Candidate Portal";
    Layout = "_Layout";
}

<h2>Candidate Portal</h2>
<p class="text-muted">Welcome! Manage your profile and resume from here.</p>

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">My Profile</h5>
                <p class="card-text">View your personal information, education and work experience.</p>
                <a asp-action="Profile" asp-controller="Candidate" class="btn btn-primary">Go to Profile</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage CV</h5>
                <p class="card-text">Create or update your resume and manage your uploaded CV file.</p>
                <a asp-action="ManageCv" asp-controller="Candidate" class="btn btn-primary">Go to Manage CV</a>
            </div>
        </div>
    </div>
</div>
