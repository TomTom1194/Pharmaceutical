@model List<WebApp.Dtos.ContentPageDto>
@{
    ViewData["Title"] = "Manage Pages";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Content Pages</h2>
            <p class="text-muted mb-0">Manage static content for your website</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.Title</td>
                                <td><code>@item.Slug</code></td>
                                <td>
                                    @{
                                        var badge = item.Status switch
                                        {
                                            "Published" => "success",
                                            "Draft" => "secondary",
                                            _ => "light"
                                        };
                                    }
                                    <span class="badge bg-@badge">@item.Status</span>
                                </td>
                                <td class="text-muted small">@(item.UpdatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "Never")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.PageId"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">No pages found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
