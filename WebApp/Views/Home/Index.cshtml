@model WebApp.Models.HomePageContentModel
@{
    ViewData["Title"] = "Home Page";
    var banner = ViewData["BannerImageUrl"] as string ?? "https://images.unsplash.com/photo-1579684385127-1ef15d508118?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80";
}

<!-- Hero Section -->
@if (Model.SliderImages != null && Model.SliderImages.Any())
{
    <section class="hero-section position-relative" style="min-height: 500px;">
        <div id="heroCarousel" class="carousel slide carousel-fade position-absolute w-100 h-100" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.SliderImages.Count; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                }
            </div>
            <div class="carousel-inner h-100">
                @for (int i = 0; i < Model.SliderImages.Count; i++)
                {
                    <div class="carousel-item h-100 @(i == 0 ? "active" : "")" style="background: linear-gradient(rgba(6, 74, 46, 0.7), rgba(6, 74, 46, 0.7)), url('@Model.SliderImages[i]') center/cover;">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="z-index: 11;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="z-index: 11;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
        
        <!-- Overlay Content -->
        <div class="container h-100 d-flex flex-column justify-content-center align-items-center position-relative text-center text-white" style="z-index: 10; padding-top: 100px; padding-bottom: 100px;">
            <h1 class="display-4 fw-bold mb-3">@(string.IsNullOrEmpty(Model.HeroTitle) ? "Welcome to XYZ Pharmaceuticals" : Model.HeroTitle)</h1>
            <p class="lead mb-4">@(string.IsNullOrEmpty(Model.HeroSubtitle) ? "Professional machinery for laboratories and pharmaceutical manufacturers." : Model.HeroSubtitle)</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-lg px-5 py-3 fw-bold rounded-pill shadow hover-lift" style="letter-spacing: 1px;">View Our Products <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>
    </section>
}
else
{
    <section class="hero-section text-white text-center d-flex align-items-center" 
             style="background: linear-gradient(rgba(6, 74, 46, 0.85), rgba(6, 74, 46, 0.85)), url('@banner') center/cover; min-height: 500px;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">@(string.IsNullOrEmpty(Model.HeroTitle) ? "Welcome to XYZ Pharmaceuticals" : Model.HeroTitle)</h1>
            <p class="lead mb-4">@(string.IsNullOrEmpty(Model.HeroSubtitle) ? "Professional machinery for laboratories and pharmaceutical manufacturers." : Model.HeroSubtitle)</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-lg px-5 py-3 fw-bold rounded-pill shadow hover-lift" style="letter-spacing: 1px;">View Our Products <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>
    </section>
}

<!-- Feature/Category Cards -->
<section class="py-5" style="background-color: #f8fafc;">
    <div class="container py-lg-5">
        <div class="text-center mb-5">
            <span class="text-success fw-bold text-uppercase letter-spacing-1 small">Our Solutions</span>
            <h2 class="display-6 fw-bold text-dark mt-2">Industrial Machinery Categories</h2>
        </div>
        <div class="row g-4 justify-content-center">
            <!-- Category 1 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift position-relative overflow-hidden" style="border-top: 4px solid #16a34a !important; transition: all 0.3s ease;">
                    <div class="card-body p-5 text-center">
                        <div class="bg-success-subtle d-inline-flex rounded-circle p-4 mb-4">
                            <i class="bi bi-capsule fs-1 text-success"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">Capsule Machines</h4>
                        <p class="text-muted mb-4">High-speed, precision encapsulation equipment designed for maximum yield and GMP compliance.</p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="text-success fw-bold text-decoration-none stretched-link">
                            Explore Series <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!-- Category 2 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift position-relative overflow-hidden" style="border-top: 4px solid #16a34a !important; transition: all 0.3s ease;">
                    <div class="card-body p-5 text-center">
                        <div class="bg-success-subtle d-inline-flex rounded-circle p-4 mb-4">
                            <i class="bi bi-prescription fs-1 text-success"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">Tablet Presses</h4>
                        <p class="text-muted mb-4">Robust and efficient tablet compression technology handling complex formulations with ease.</p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="text-success fw-bold text-decoration-none stretched-link">
                            Explore Series <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <!-- Category 3 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift position-relative overflow-hidden" style="border-top: 4px solid #16a34a !important; transition: all 0.3s ease;">
                    <div class="card-body p-5 text-center">
                        <div class="bg-success-subtle d-inline-flex rounded-circle p-4 mb-4">
                            <i class="bi bi-droplet-half fs-1 text-success"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-3">Liquid Filling</h4>
                        <p class="text-muted mb-4">Accurate, sterile liquid filling systems integrating seamlessly into continuous production lines.</p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="text-success fw-bold text-decoration-none stretched-link">
                            Explore Series <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Premium About Us Section -->
<section class="py-5 my-lg-5 overflow-hidden">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 position-relative z-index-1">
                <span class="d-block text-success fw-bold text-uppercase mb-2" style="letter-spacing: 2px; font-size: 0.85rem;">Who We Are</span>
                <h2 class="display-5 fw-bold text-dark mb-4 lh-sm">@(string.IsNullOrEmpty(Model.AboutTitle) ? "Leading the future of PharmaTech" : Model.AboutTitle)</h2>
                <p class="fs-5 text-secondary lh-lg mb-5" style="font-weight: 300;">
                    @(string.IsNullOrEmpty(Model.AboutDescription) ? "We are a leading provider of state-of-the-art pharmaceutical manufacturing equipment, committed to driving innovation, precision, and efficiency in the global healthcare sector." : Model.AboutDescription)
                </p>
                <a asp-controller="Home" asp-action="About" class="btn btn-outline-success btn-lg px-5 rounded-pill shadow-sm hover-lift">Discover Our Story</a>
            </div>
            <div class="col-lg-6">
                <div class="position-relative ps-lg-5">
                    <!-- Decor block -->
                    <div class="position-absolute rounded-5 bg-success opacity-10" style="top: -20px; right: -20px; bottom: 20px; left: 20px; z-index: 0;"></div>
                    <!-- Main image -->
                    <img src="https://images.unsplash.com/photo-1631549916768-4119b2e5f926?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Pharma Innovation" class="img-fluid rounded-5 shadow-lg position-relative w-100" style="object-fit: cover; height: 480px; z-index: 1;" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Dark Stat/Feature Bar -->
<section class="py-5 bg-dark text-white">
    <div class="container py-3">
        <div class="row text-center g-4">
            <div class="col-md-4 border-end border-secondary">
                <h2 class="display-5 fw-bold text-success mb-2">100%</h2>
                <h5 class="fw-normal mb-0 opacity-75">GMP & FDA Compliant</h5>
            </div>
            <div class="col-md-4 border-end border-secondary">
                <h2 class="display-5 fw-bold text-success mb-2">24/7</h2>
                <h5 class="fw-normal mb-0 opacity-75">Global Technical Support</h5>
            </div>
            <div class="col-md-4">
                <h2 class="display-5 fw-bold text-success mb-2">50+</h2>
                <h5 class="fw-normal mb-0 opacity-75">Countries Served</h5>
            </div>
        </div>
    </div>
</section>